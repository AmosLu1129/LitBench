# SPDX-License-Identifier: AGPL-3.0-or-later
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
#
# 两种用法：
#   * `docker compose`：.env 会被 compose 读来做变量插值，文件里的值经
#     compose.yaml 的 x-app-env 显式注入 api / worker 容器；
#   * 本地直接跑 server/：`cd server` 后 pydantic-settings 会读当前目录的 .env
#     （可以在 server/ 下另放一份，或把这里的变量 export 到环境）。
#
# 注意：
#   * DATABASE_URL / STORAGE_DIR 由 compose.yaml 按容器网络直接注入，
#     不需要在这里填；本地开发不设时用 server/litbench/config.py 的默认值。
#   * 想新增一个进容器的变量，除了写在这里，还要加进 compose.yaml 的 x-app-env，
#     否则它只参与插值、不会出现在容器环境里。

POSTGRES_PASSWORD=litbench

# 端口与绑定（M7 部署收尾）
# api/web 默认只绑 127.0.0.1：局域网只从 HTTPS 反代（proxy profile）进来，别把 API 直接暴露。
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=8080
# HTTPS 反代（docker compose --profile lan up -d）；证书生成见 scripts/gen_selfsigned_cert.sh
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
# MCP 出口容器（docker compose --profile mcp up -d）；默认只给本机 agent
MCP_BIND=127.0.0.1
MCP_PORT=8765

# 单次上传大小上限（MB），前后端共用
MAX_UPLOAD_MB=200
# CORS 允许来源，逗号分隔（默认：Vite 开发端口 + compose 的 web 端口）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# 解析后端：pdfium（默认，零模型）| docling（需 INSTALL_DOCLING=1）| mineru（需先起 ocr profile / CLI）
PARSER_BACKEND=pdfium

# 是否为每张图渲染缩略图（整页渲染 + 裁剪）。关掉省 10–20% 解析时间，但界面图卡片会全变「无图片」。
RENDER_FIGURE_IMAGES=true

# 按需升级：轻量档解析完发现「图号没定位到图」或「图注被截断」时，自动再排一次增强档。
# 置空即关闭（ESCALATE_BACKEND=）。需要增强档镜像里装了 docling（INSTALL_DOCLING=1）。
ESCALATE_BACKEND=docling
ESCALATE_MIN_MISSING=1
ESCALATE_MIN_CAPTION_CHARS=40

# ===== OCR（扫描件：没有文字层时自动触发）=====
# OCR_BACKEND：mineru | docling | 空字符串=关闭。
# 许可证：MinerU 是 AGPL-3.0，只能用独立 venv / 容器里的 CLI 子进程，主进程绝不 import。
OCR_BACKEND=mineru

# MinerU 子进程（本机实测安装位置；容器部署时改容器内路径）
MINERU_CMD=C:\mineru-env\Scripts\mineru-kit.exe
# 必须是 ASCII 路径：MinerU 的 C++ 解析层打不开中文路径；子进程只能写这里
MINERU_WORKDIR=C:\litbench\.data\mineru-work
# 模型与 config.yaml 目录（config.yaml 的 model.base_dir 指向 .../models）；权重不进仓库
MINERU_HOME=C:\litbench\.data\mineru-home
MINERU_MODEL_SOURCE=modelscope
# flash|basic|standard|advanced；flash 只出文本+图块，不产独立 caption/结构化表格
MINERU_TIER=flash
MINERU_TIMEOUT_S=3600

# Docling 走 OCR 时用 RapidOCR 中文模型（主镜像装 onnxruntime 即可，MIT）
DOCLING_OCR_LANG=chinese

# ===== 双 OCR 交叉校核（阶段 2，docs/14）=====
# 第二套 OCR：RapidOCR（PP-OCRv4，Apache-2.0，随主镜像），只识别图注区域小图。
OCR_CROSS_ENABLED=true
OCR_CROSS_DPI=200
# 文字层质量分低于它 → 降权文字层，跑两套 OCR 交叉（0–1）
TEXT_QUALITY_MIN=0.8

# 解析后过滤：教材里「扫码看课件」的独立二维码会被版面模型当成图片块
# （实测 5 本教材混入 4 张）。关掉它二维码会以「图」的身份进库。
FILTER_QR_FIGURES=true

# 旧路径：MinerU 走独立容器（compose --profile ocr）时才用；CLI 子进程方案不需要
# MINERU_URL=
# MINERU_IMAGE=ghcr.io/opendatalab/mineru:latest

# LLM：BYO（自带 key），服务端不内置任何密钥
# LLM_PROVIDER（可选）：mock | api | deepseek
#   mock     = 默认，无 key 的确定性假响应（跑通流程/测试用）
#   api      = 在界面「设置」里配置的 BYO 网关（推荐，key 只落 storage_dir）
#   deepseek = 旧的 env 方式，直接用下面的 LLM_* 变量
LLM_PROVIDER=mock
# LLM_BASE_URL / LLM_API_KEY / LLM_MODEL 在容器部署时经 compose 注入；
# 留空即不接真实模型（mock 时会自动跳过网络请求）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 超时秒数 / 单次输出 token 上限
LLM_TIMEOUT_S=60.0
LLM_MAX_TOKENS=1200

# 摘要自动接受阈值（0–1）：置信度 ≥ 该值的草稿直接入库为 published
SUMMARY_AUTO_ACCEPT_CONFIDENCE=0.9

# ===== 团队共享 / 认证（M7）=====
# 0 = 单机模式（无需登录，沿用旧行为）；1 = 局域网/多人使用，首次打开页面初始化管理员。
# 部署到局域网前一定要设 1 并完成管理员初始化，再开放端口。
AUTH_ENABLED=0
# 走 HTTPS 反代（profile lan）时设 true，cookie 带 Secure；纯 HTTP 内网测试保持 false
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=14

# MCP 内部服务令牌：认证打开后，MCP 调 /api/* 会 401；API 允许
# X-LitBench-Internal-Token 与该值一致时以 system 身份放行（全库只读/管理）。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# api 容器（INTERNAL_API_TOKEN）与 MCP 进程（LITBENCH_MCP_API_TOKEN）必须一致；
# 留空 = 不启用（MCP 只能在 AUTH_ENABLED=0 下用）。
INTERNAL_API_TOKEN=

# ===== 写作完整度（M8）：CSL 引用 / Word·PDF 导出 / 元数据补全 =====
# pandoc / typst 已固定装在 api 镜像的 PATH；本地开发用 scripts/get_pandoc.py、
# scripts/get_typst.py 装到 .data/tools/。空 = 自动查找（项目内便携版优先于 PATH）。
PANDOC_PATH=
TYPST_PATH=
# 太多人反馈导出按钮一直转时可以先关掉（模板/LaTeX 导出不受影响）
DOCX_EXPORT_ENABLED=true
PDF_EXPORT_ENABLED=true
# PDF 正文字体；空 = typst 默认字体 + 系统字体回退（镜像里已装 Noto CJK）
PDF_MAIN_FONT=
# Crossref 礼貌池建议留联系邮箱（可空；只进 User-Agent，不落库/日志）
CROSSREF_MAILTO=

# 本地模型（可选）
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen3-vl:32b
