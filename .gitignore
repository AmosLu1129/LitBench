# 环境
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
# pytest 的 tmp_path 在本机落到了 server/ 下，别让它进仓库
pytest-of-*/
.pytest_tmp/

# Node
node_modules/
dist/
build/
.vite/

# 运行数据（本地卷）
.data/
data/
*.log
# Docling / HF 模型缓存（本地验证时用可写目录绕开权限问题）
.hf-cache/

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# pip 安装失败时会在当前目录留临时解包目录
pip-metadata-*/
pip-unpack-*/

# PyTorch Inductor 临时缓存
torchinductor_*/
